<mxfile host="drawio"><diagram name="D3 FSM light"><mxGraphModel grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="D3  FSM ของโมดูลแสง  (light_control_task ทุก 200 ms)&#xa;สองส่วนทำงานพร้อมกัน: duty_CW = B × r ,  duty_WW = B × (1 - r)" style="text;html=1;align=center;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1281" height="50" as="geometry"/></mxCell><mxCell id="c0" value="ส่วน B: สีแสง (r = สัดส่วนขาวเย็น)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7030A0;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="8" y="366" width="1265" height="180" as="geometry"/></mxCell><mxCell id="c1" value="ส่วน A: สถานะไฟ (ความสว่างรวม B)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2F5597;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="8" y="46" width="963" height="312" as="geometry"/></mxCell><mxCell id="n2" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="16" y="464" width="11" height="11" as="geometry"/></mxCell><mxCell id="n3" value="C0  NEUTRAL&#xa;r = 0.50&#xa;(ยังไม่รู้เวลา)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="137" y="445" width="96" height="47" as="geometry"/></mxCell><mxCell id="n4" value="C1  DAY&#xa;07:00-16:59&#xa;r = 0.80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="376" y="445" width="83" height="47" as="geometry"/></mxCell><mxCell id="n5" value="C2  TRANSITION&#xa;17:00-18:59&#xa;r: 0.80 ลดเป็น 0.00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="603" y="490" width="116" height="47" as="geometry"/></mxC